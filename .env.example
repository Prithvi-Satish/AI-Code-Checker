# Copy to .env and fill in values. Never commit .env.

# GitHub App (Phase 2 - leave empty for Phase 1 webhook testing)
GITHUB_APP_ID=
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret_from_github_app_settings
# Private key: paste PEM from GitHub App. In .env you can use \n for newlines in one line, or paste multi-line.
GITHUB_APP_PRIVATE_KEY=

# Google AI Studio - get at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key

# Optional: server port (default 8000)
# PORT=8000
